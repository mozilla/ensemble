.chart {
    margin-top: 20px;
}

.chart-readout {
    font-size: .9rem;
    font-weight: 400;
    margin: 0 20px 0 0;
    min-height: 1.5em;
    text-align: right;
}

.chart-marker-label text {
    fill: #000;
    font-size: .8rem;
    opacity: .6;
}

.chart-empty {
    text-align: center;
}

.chart-svg {
    g[aria-label$='tick label'] text {
        fill: #000;
        font-size: .9rem;
        opacity: .6;
    }
    g[aria-label$='-axis tick'] {
        stroke: #b3b2b2;
    }
    g[aria-label$='-axis label'] text {
        font-size: .8rem;
        text-transform: uppercase;
    }
}
