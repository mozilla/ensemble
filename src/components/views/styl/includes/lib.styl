// Responsive Breakpoints
$base-tablet = unquote('all and (min-width: 550px)');
$base-desktop = unquote('all and (min-width: 1200px)');

// Colours
$link-color-normal = #0070ff;

// TODO: padding/margin spacing.

// Fonts, from springfield's --token-font-family-* tokens
$font-family-headline = 'Mozilla Headline VF', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
$font-family-text = 'Mozilla Text VF', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
