// Responsive Breakpoints
$base-tablet = unquote('all and (min-width: 550px)');
$base-desktop = unquote('all and (min-width: 1200px)');

// Colours
// Protocol's $color-link and $color-link-hover tokens
$link-color = #0060df;
$link-color-hover = #0250bb;

// Firefox dark purple (springfield's --token-color-dark-purple)
$dark-purple = #210340;

// TODO: padding/margin spacing.

// Fonts, from springfield's --token-font-family-* tokens
$font-family-headline = 'Mozilla Headline VF', 'Mozilla Headline Fallback', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
$font-family-text = 'Mozilla Text VF', 'Mozilla Text Fallback', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
