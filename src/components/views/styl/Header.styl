#main-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    padding: 15px 0;

    border-bottom: 1px solid #676767;
}

h1 {
    font-weight: 300;
    margin: 0;

    a {
        color: inherit;
        line-height: 1.5;
        display: inline-block;
        text-decoration: none;

        &:hover, &:focus-visible {
            color: inherit;
            text-decoration: underline;
        }
    }
}

#main-navigation {
    ul {
        display: flex;
        flex-wrap: wrap;
        list-style: none;
        padding: 0;
    }

    li {
        margin: 0 15px;

        &:last-child {
            margin-right: 0;
        }

        a {
            color: #000;
            font-size: 1.1rem;
            font-weight: 200;
            text-decoration: none;

            &:hover, &:focus-visible {
                color: #000;
                text-decoration: underline;
                text-decoration-thickness: 2px;
                text-underline-offset: .3em;
            }
        }
    }
}
