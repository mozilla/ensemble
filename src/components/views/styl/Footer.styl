@import 'includes/lib';

// Forked from Protocol's footer component (mzp-c-footer), with tokens resolved
// to literal values. Protocol's breakpoints differ from lib.styl's.
$footer-sm = unquote('(min-width: 480px)');
$footer-md = unquote('(min-width: 768px)');
$footer-lg = unquote('(min-width: 1024px)');
$footer-sm-only = unquote('(min-width: 480px) and (max-width: 1023px)');
$footer-secondary = #c8b2f6;

footer-line() {
    border-bottom: 1px solid $footer-secondary;
}

clearfix() {
    &::after {
        clear: both;
        content: '';
        display: block;
        height: 0;
        visibility: hidden;
    }
}

image-replaced() {
    direction: ltr;
    overflow: hidden;
    text-align: left;
    text-indent: -9999px;
    white-space: nowrap;
}

.c-footer {
    background: #210340;
    clear: both;
    color: #fff;
    font-family: $font-family-text;
    font-weight: normal;
    margin: 0;
    padding: 48px 0;
    width: 100%;

    // Undo the global link, paragraph, and heading styles from Application.styl.
    // :where() keeps the resets at class-level specificity so the c-footer-*
    // rules below can override them.
    a {
        color: #fff;
        font-weight: normal;
        text-decoration: underline;

        &:hover, &:focus-visible, &:active {
            border-bottom: 0;
            color: #fff;
            text-decoration: none;
        }

        &:focus-visible {
            outline-color: #fff;
        }
    }

    :where(p), :where(span) {
        font-size: inherit;
        line-height: inherit;
        margin: 0;
    }

    :where(ul) {
        margin: 0;
        padding: 0;
    }
}


.c-footer-primary {
    box-sizing: border-box;
    font-size: 1rem;
    line-height: 1.25;
    margin: 0 auto 32px;
    clearfix();

    @media $footer-lg {
        margin-bottom: 24px;
    }
}

.c-footer-primary-logo {
    margin-bottom: 32px;

    @media $footer-lg {
        margin-bottom: 64px;
    }

    a {
        background: url(../img/footer/firefox-logo-white.svg) no-repeat;
        background-size: contain;
        display: inline-block;
        height: 40px;
        width: 140px;
        image-replaced();
    }
}

.c-footer-sections {
    padding-bottom: 32px;
    footer-line();
    clearfix();

    @media $footer-sm {
        padding-bottom: 0;
    }
}

.c-footer-section {
    margin-bottom: 8px;
    clearfix();

    @media $footer-sm {
        margin-bottom: 0;
    }

    a {
        text-decoration: none;

        &:hover, &:focus-visible, &:active {
            text-decoration: underline;
        }
    }

    @media $footer-sm-only {
        box-sizing: border-box;
        float: left;
        width: 50%;

        &:nth-child(odd) {
            clear: left;
            padding-right: 24px;
        }

        &:nth-child(even) {
            padding-left: 24px;
        }
    }

    // Protocol sizes columns for 2-6 sections; ensemble only ever has two.
    @media $footer-lg {
        float: left;
        padding: 0 24px;
        width: calc(50% - 24px);

        &:first-child {
            padding-left: 0;
        }

        &:last-child {
            padding-right: 0;
        }
    }
}

.c-footer-heading {
    background-color: transparent;
    color: $footer-secondary;
    font-family: $font-family-text;
    font-size: 1.1rem;
    font-weight: bold;
    line-height: 1.25;
    margin: 0;
    padding: 16px 0;
    position: relative;
    text-align: left;
    width: 100%;

    @media $footer-sm {
        padding: 0 0 16px;
    }

    @media $footer-lg {
        padding-bottom: 24px;
    }
}

.c-footer-list {
    margin-bottom: 32px;
    margin-top: 16px;

    @media $footer-sm {
        margin-top: 0;
    }

    @media $footer-lg {
        margin-bottom: 64px;
    }

    li {
        list-style-type: none;
        margin-bottom: 16px;
    }
}

.c-footer-secondary {
    color: $footer-secondary;
    font-size: 1rem;
    line-height: 1.25;
    position: relative;

    .c-footer & a {
        color: $footer-secondary;

        &:hover, &:focus-visible, &:active {
            color: $footer-secondary;
            text-decoration: none;
        }
    }
}

.c-footer-links-social {
    li {
        display: inline-block;
        list-style-type: none;
        margin: 0 16px 0 0;
        vertical-align: bottom;
    }

    a {
        background-repeat: no-repeat;
        border-bottom: 1px solid transparent;
        display: block;
        height: 16px;
        width: 16px;
        image-replaced();

        &:hover, &:focus-visible {
            border-bottom: 1px solid #fff;
        }

        &.bluesky {
            background-image: url(../img/footer/bluesky-white.svg);
        }

        &.instagram {
            background-image: url(../img/footer/instagram-white.svg);
        }

        &.linkedin {
            background-image: url(../img/footer/linkedin-white.svg);
        }

        &.spotify {
            background-image: url(../img/footer/spotify-white.svg);
        }

        &.tiktok {
            background-image: url(../img/footer/tiktok-white.svg);
        }

        &.youtube {
            background-image: url(../img/footer/youtube-white.svg);
        }
    }
}

.c-footer-legal {
    li {
        list-style-type: none;
        margin-bottom: 16px;

        &:last-child {
            margin-bottom: 0;
        }
    }

    @media $footer-md {
        li {
            display: inline-block;
            padding-right: 24px;

            &:last-child {
                padding-right: 0;
            }
        }
    }
}

.c-footer-license {
    margin-bottom: 32px;

    @media $footer-lg {
        margin-bottom: 24px;
    }
}
