main > .spinner {
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 20px 0;

    /* Give this element a static height so that the next button doesn't get
     * pushed down when the spinner appears. */
    height: 200px;

    + .next-button {
        margin-top: 0;
    }
}

// While a dashboard loads, its proceed button would sit just below the
// spinner, then jump down the page when the dashboard arrives.
main.dashboard-route > .spinner + .next-button {
    display: none;
}
