@import 'includes/lib';

html {
    box-sizing: border-box;
}

// Only woff2: every browser that can run this app supports it.
// Mozilla Text has no italic axis, so italics come from static files.
// @stylint off
@font-face {
    src: url('../fonts/mozilla-headline/MozillaHeadline-Variable.woff2') format('woff2');
    font-family: 'Mozilla Headline VF';
    font-display: swap;
    font-stretch: 75% 125%;
    font-style: normal;
    font-weight: 200 700;
}

@font-face {
    src: url('../fonts/mozilla-text/MozillaText-Variable.woff2') format('woff2');
    font-family: 'Mozilla Text VF';
    font-display: swap;
    font-style: normal;
    font-weight: 200 700;
}

@font-face {
    src: url('../fonts/mozilla-text/MozillaText-Italic.woff2') format('woff2');
    font-family: 'Mozilla Text VF';
    font-display: swap;
    font-style: italic;
    font-weight: 400;
}

@font-face {
    src: url('../fonts/mozilla-text/MozillaText-SemiBoldItalic.woff2') format('woff2');
    font-family: 'Mozilla Text VF';
    font-display: swap;
    font-style: italic;
    font-weight: 600;
}

@font-face {
    src: url('../fonts/mozilla-text/MozillaText-BoldItalic.woff2') format('woff2');
    font-family: 'Mozilla Text VF';
    font-display: swap;
    font-style: italic;
    font-weight: 700;
}
// Arial, or Liberation Sans or Arimo, which share its metrics on Linux and
// ChromeOS, scaled so that a line of the site's text is as wide in it as in the
// Mozilla fonts, so that text doesn't reflow when they arrive. Arial Bold is
// wider than Arial, so it has its own scale. ascent-override and friends would
// match the line heights too, but Safari doesn't support them.
@font-face {
    src: local('Arial'), local('Liberation Sans'), local('Arimo');
    font-family: 'Mozilla Text Fallback';
    font-weight: 200 500;
    size-adjust: 109.43%;
}

@font-face {
    src: local('Arial Bold'), local('Arial-BoldMT'), local('Liberation Sans Bold'), local('Arimo Bold');
    font-family: 'Mozilla Text Fallback';
    font-weight: 600 700;
    size-adjust: 102.25%;
}

@font-face {
    src: local('Arial'), local('Liberation Sans'), local('Arimo');
    font-family: 'Mozilla Headline Fallback';
    font-weight: 200 500;
    size-adjust: 105.47%;
}

@font-face {
    src: local('Arial Bold'), local('Arial-BoldMT'), local('Liberation Sans Bold'), local('Arimo Bold');
    font-family: 'Mozilla Headline Fallback';
    font-weight: 600 700;
    size-adjust: 98.55%;
}

// @stylint on

/* Jon Neal approach to a box-sizing reset. */
*, *::before, *::after { // @stylint ignore
    box-sizing: inherit;
}

body {
    color: #000;
    font-family: $font-family-text;
    font-size: 16px;
    font-weight: 200;
    margin: 0;
    padding: 0;
    background-size: 1920px auto;
}

// A column at least as tall as the window, with main taking the spare height,
// so that on a short page the footer sits at the bottom of the window. The gap
// above the header is padding, not an offset, so it counts toward that height.
// .app-shell is the copy of the header in index.html, shown until React
// renders, and must sit exactly where #application will.
#application, .app-shell {
    display: flex;
    flex-direction: column;
    min-height: 100svh;
    padding-top: 10px;
    position: relative;
}

#main-header, main, footer > div {
    margin: 0 auto;
    width: 95vw;
}

main {
    flex-grow: 1;
    padding: 12px 0;
}

// Until a dashboard loads, keep the footer below the fold, so that it doesn't
// jump off the screen when the dashboard arrives. A loaded dashboard is always
// taller than this. It is the tallest the window can be, unlike the svh above,
// so that the footer stays out of sight on phones too.
main.dashboard-route {
    min-height: 100vh;
}

// The same for any page, before the scripts run and while a page's code loads.
main:empty,
main:has(> .spinner:only-child) {
    min-height: 100vh;
}

// Main.jsx moves focus to these after a navigation, as a page load would. They
// aren't controls, so a focus ring would only look like a stray highlight.
main:focus,
[data-page-heading]:focus {
    outline: none;
}

// Hidden from view but still read by screen readers.
.visually-hidden {
    clip-path: inset(50%);
    height: 1px;
    margin: -1px;
    overflow: hidden;
    padding: 0;
    position: absolute;
    white-space: nowrap;
    width: 1px;
}

a {
    color: $link-color;
    font-weight: bold;
    text-decoration: none;
}

a:hover, a:focus-visible {
    color: $link-color-hover;
    text-decoration: underline;
    text-underline-offset: .15em;
}

a:focus-visible {
    outline: 2px solid $link-color-hover;
    outline-offset: 2px;
}

p, span {
    font-size: 1rem;
    line-height: 28px;
    margin: 10px 0;
}

h1, h2, h3, h4, h5, h6 {
    color: $dark-purple;
    font-family: $font-family-headline;
}

h2, h3 {
    font-size: 17px;
}

.contrasted {
    align-items: center;
    background-color: $dark-purple;
    color: #fff;
    display: flex;
    font-size: 32px;
    font-weight: normal;
    line-height: 1.2;
    padding: 10px;
    margin-top: 40px;
}

dd {
    margin: 0;
}

@media $base-tablet {
    body {
        font-size: 16px;
    }

    #application, .app-shell {
        padding-top: 40px;
    }

    #main-header, main, footer > div {
        width: 85vw;
    }

    p, span {
        font-size: 1.1rem;
    }

    main {
        padding: 20px 0;
    }
}

@media $base-desktop {
    #main-header, main, footer > div {
        width: 1170px;
    }
}
