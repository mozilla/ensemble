.metric-overview {
    align-items: center;
    display: flex;
    flex-direction: column;
    flex-wrap: wrap;
    justify-content: space-between;
    margin: 50px 0;

    &:first-child {
        margin-top: 0;
    }
    &:last-child {
        margin-bottom: 0;
    }
    // As wide as main, like the chart, so that the spinner holding the
    // chart's place can be as big as the chart. Stretching it instead would
    // come too late: its height is settled first, while it is still 0px wide.
    .metric-and-legend {
        width: 100%;
    }
    .metric-and-legend > div {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
    }
    // The chart's size, from ChartContainer: as wide as main, and square up
    // to 400px tall, below the 20px margin and 28px readout line above it.
    .metric-and-legend > .spinner {
        align-items: center;
        aspect-ratio: 1; // @stylint ignore
        margin-top: 48px;
        max-height: 400px;
        width: 100%;
    }
    .legend {
        max-width: 1100px;

        .legend-entry {
            background: none;
            border: 0;
            cursor: pointer;
            display: block;
            font-family: inherit;
            font-size: .9rem;
            font-weight: 400;
            margin: 5px;
            padding: 0;

            &[aria-pressed='false'] {
                opacity: .4;
                text-decoration: line-through;
            }
            &:disabled {
                cursor: default;
            }
        }
    }
    .striped {
        width: 100%;
    }
}

.metric-description p {
    font-size: 1.1rem;

    &:only-child {
        margin-top: 0;
        margin-bottom: 0;
    }
    /* Exclude the top margin of the first paragraph of a multi-paragraph
       description */
    &:first-child {
        margin-top: 0;
    }
    /* Exclude the bottom margin of the last paragraph of a multi-paragraph
       description */
    &:last-child {
        margin-bottom: 0;
    }
}
