@import 'includes/lib';

// Flare's primary button (springfield media/css/cms/components/flare-button.css),
// with its tokens resolved to literal values.
$btn-color = #7543e3;
$btn-color-hover = #6132bc;
$btn-color-active = #3a0f6e;

.next-button {
    display: flex;
    justify-content: center;
    margin: 50px 0;

    a {
        align-items: center;
        background-color: $btn-color;
        border: 2px solid transparent;
        border-radius: 128px;
        color: #fff;
        display: inline-flex;
        font-family: $font-family-text;
        font-size: 1rem;
        font-weight: 600;
        gap: 12px;
        justify-content: center;
        line-height: 1;
        padding: 12px 24px;
        text-align: center;
        text-decoration: none;
        transition: background-color .15s ease, color .15s ease, border-color .15s ease;

        // Flare's forward icon, masked so it takes the text colour.
        .next-button-icon {
            background-color: currentColor;
            display: inline-block;
            flex-shrink: 0;
            height: 16px;
            margin: 0; // the global span margin would make the button taller
            width: 16px;
            -webkit-mask: url(../img/icons/forward-16.svg) no-repeat center / contain;
            mask: url(../img/icons/forward-16.svg) no-repeat center / contain;
        }

        &:hover {
            background-color: $btn-color-hover;
            color: #fff;
            text-decoration: none;
        }

        &:active {
            background-color: $btn-color-active;
            border-color: $btn-color-active;
            outline: none;
        }

        &:focus-visible {
            color: #fff;
            outline: 2px solid $btn-color;
            outline-offset: 2px;
            text-decoration: none;
        }
    }
}
