{
    "name": "ensemble",
    "version": "1.2.1",
    "private": true,
    "engines": {
        "node": "^24.15.0"
    },
    "scripts": {
        "start": "npm-run-all --parallel watch:css watch:app",
        "watch:css": "stylus --watch --sourcemap src/components/views/styl/* --out ./src/components/views/css/",
        "watch:app": "vite",
        "build": "npm-run-all build:*",
        "build:css": "stylus --sourcemap ./src/components/views/styl/* --out ./src/components/views/css/",
        "build:app": "vite build",
        "build:version.json": "node scripts/generateVersionJSON",
        "test": "npm-run-all lint test:jest test:playwright",
        "lint": "npm-run-all lint:*",
        "lint:js": "eslint .",
        "lint:styl": "stylint src/components/views/styl",
        "test:jest": "vitest run",
        "test:playwright": "playwright test",
        "test:playwright:recorded": "playwright test --project=chromium --project=chromium-no-js",
        "test:playwright:live": "playwright test --project=live-data",
        "posttest": "npm audit || true",
        "size": "source-map-explorer build/assets/index-*.js --no-border-checks",
        "record:fixtures": "node scripts/recordPlaywrightFixtures.js"
    },
    "dependencies": {
        "d3-scale": "4.0.2",
        "d3-selection": "3.0.0",
        "d3-shape": "3.2.0",
        "dateformat": "5.0.4",
        "distinct-colors": "3.0.0",
        "markdown-it": "15.0.3",
        "markdown-it-sup": "2.0.0",
        "memoize-one": "6.0.0",
        "metrics-graphics": "2.15.6",
        "npm-run-all2": "9.0.3",
        "react": "18.3.1",
        "react-dom": "18.3.1",
        "react-ga4": "3.0.1",
        "react-helmet-async": "3.0.0",
        "react-router": "7.18.4",
        "react-spinners": "0.17.1",
        "stylus": "0.64.0"
    },
    "devDependencies": {
        "@eslint/js": "9.39.5",
        "@playwright/test": "1.64.1",
        "@testing-library/dom": "10.4.2",
        "@testing-library/jest-dom": "7.0.1",
        "@testing-library/react": "16.3.3",
        "@testing-library/user-event": "14.6.8",
        "@vitejs/plugin-react": "6.1.2",
        "@vitest/eslint-plugin": "1.6.27",
        "eslint": "9.39.5",
        "eslint-plugin-jsx-a11y": "6.10.2",
        "eslint-plugin-react": "7.37.5",
        "globals": "17.13.0",
        "jsdom": "30.1.3",
        "source-map-explorer": "2.5.3",
        "stylint": "2.0.0",
        "vite": "8.3.4",
        "vitest": "5.0.5"
    }
}
